{
  "name": "Thunderbird Websites",
  "build":?{
    "dockerfile": "../docker/Dockerfile",
    "context": ".."
  },
  "forwardPorts": [80],
  "portsAttributes": {
    
    "host:chase385.wordpress.com": {
      "label": "WELLS"
    }
  "customizations": {
    
    "vscode": {
      "extensions": [
        "ms-python.python",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  },
  
    "User": "root",
  "containerEnv": {
    "MAILFENCE_APIKEY": "${localEnv:MAILFENCE_APIKEY}"
  }
}

